:root{color-scheme:dark;--bg:#0f141a;--surface:#18202a;--surface-alt:#111820;--border:#273240;--text:#e6edf3;--muted:#9fb0c0;--amber:#f2b84b;--teal:#4fd1c5;--coral:#ff7a6b;--success:#4fd1c5;--warning:#f2b84b;--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:20px;--space-6:24px}*{box-sizing:border-box}html{background:var(--bg)}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 "IBM Plex Sans",system-ui,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;min-height:40px}button:disabled{cursor:not-allowed;opacity:.55}:focus-visible{outline:2px solid var(--teal);outline-offset:2px}.topbar{min-height:76px;display:flex;align-items:center;justify-content:space-between;padding:14px clamp(18px,4vw,56px);border-bottom:1px solid var(--border);background:var(--surface)}.brand h1,.panel h1,.panel h2,.panel h3{font-family:"Space Grotesk",system-ui,sans-serif}.brand h1{margin:0;font-size:22px}.eyebrow,.section-kicker{margin:0;color:var(--teal);font-size:12px;font-weight:700;letter-spacing:.14em}.learner{display:grid;grid-template-columns:auto 170px;align-items:center;gap:2px 8px;color:var(--muted);font-size:12px}.learner input{grid-column:2;min-height:40px;width:170px;padding:8px;color:var(--text);background:var(--surface-alt);border:1px solid var(--border);border-radius:4px}.learner small{grid-column:2;color:var(--muted);font-size:12px}.app-shell{display:grid;grid-template-columns:260px minmax(0,1fr) 360px;gap:16px;max-width:1600px;margin:0 auto;padding:20px}.panel{min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:6px}.navigator,.feedback-panel{align-self:start;position:sticky;top:20px;padding:16px}.middle-column{display:grid;gap:16px;min-width:0}.feedback-column{min-width:0}.panel-heading,.challenge-head,.editor-head,.actions,.trace-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px}.panel-heading{align-items:flex-start}.panel h2{margin:0;font-size:17px}.panel h3{margin:0 0 8px;font-size:13px}.muted{color:var(--muted);font-size:12px}.status{min-height:0;color:var(--amber)}.status:empty{display:none}.challenge-list{display:grid;gap:6px;margin-top:16px}.challenge-item{width:100%;padding:10px;color:var(--text);text-align:left;background:transparent;border:1px solid transparent;border-radius:4px}.challenge-item:hover,.challenge-item.active{background:var(--surface-alt);border-color:var(--border)}.challenge-item.active{box-shadow:inset 2px 0 var(--teal)}.challenge-item strong,.challenge-item small{display:block}.challenge-item strong{font-size:13px}.challenge-item small{margin-top:4px;color:var(--muted);font-size:12px}.challenge-meta{display:flex;align-items:center;gap:6px;margin-top:6px}.status-dot{width:8px;height:8px;border-radius:50%;background:#66717b}.status-dot.failed{background:var(--coral)}.status-dot.solved{background:var(--teal)}.next-badge{padding:2px 5px;color:var(--amber);border:1px solid var(--amber);border-radius:3px;font-size:12px}.challenge-panel,.results,.visualizer,.learner-panel{padding:20px}.badge,.chips span,.tag,.outcome-chip{display:inline-block;border-radius:999px;font-size:12px;font-weight:600}.badge{padding:3px 8px;color:var(--amber);background:#3d2e14}.description{max-width:80ch;margin:16px 0 12px;color:var(--muted)}.chips{display:flex;flex-wrap:wrap;gap:8px}.chips span{padding:3px 8px;color:var(--teal);background:#123735;border:1px solid #255b57}details{margin-top:20px;border-top:1px solid var(--border)}summary{padding:12px 0;color:var(--text);cursor:pointer}.examples{display:grid;gap:8px;padding-bottom:12px}.example{padding:12px;color:var(--muted);background:var(--surface-alt);border-left:2px solid var(--border)}code,pre,textarea{font-family:"IBM Plex Mono",Consolas,monospace}.example code,.test code{color:var(--teal)}.editor-head{margin-top:20px;align-items:flex-end}.editor-head h3{margin:2px 0 0}.editor-head span{color:var(--muted);font-size:12px}.editor-wrap{display:grid;grid-template-columns:44px minmax(0,1fr);margin-top:8px;background:var(--surface-alt);border:1px solid var(--border);border-radius:4px;overflow:hidden}.line-numbers{margin:0;padding:16px 10px;color:#647180;text-align:right;line-height:1.6;user-select:none}.code{display:block}#code{display:block;width:100%;min-height:290px;padding:16px;color:var(--text);background:transparent;border:0;resize:none;line-height:1.6;tab-size:4}.actions{justify-content:flex-start;flex-wrap:wrap;margin-top:12px}.primary,.secondary{padding:8px 12px;color:var(--text);border:1px solid var(--border);border-radius:4px}.primary{color:#17130a;background:var(--amber);border-color:var(--amber);font-weight:700}.secondary{background:var(--surface-alt)}.secondary:hover{border-color:var(--teal)}.trace-select{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px}.trace-select select,select{min-height:40px;padding:7px 9px;color:var(--text);background:var(--surface-alt);border:1px solid var(--border);border-radius:4px}.full-width{width:100%;margin-top:12px}.outcome{margin:16px 0;padding:12px;color:var(--teal);border:1px solid #27635e;background:#12312f;border-radius:4px;font-weight:600}.outcome.failed{color:var(--coral);border-color:#6b322c;background:#351b1a}.test-results,.hidden-results{display:grid;gap:8px}.test,.hidden-test{display:grid;gap:4px;padding:12px;background:var(--surface-alt);border-left:3px solid var(--border)}.test.pass{border-left-color:var(--teal)}.test.fail{border-left-color:var(--coral)}.test span{color:var(--muted);font-size:12px}.hidden-results{margin-top:12px}.hidden-test{grid-template-columns:1fr auto;align-items:center}.outcome-chip{padding:3px 8px;color:var(--text);background:#34404b}.outcome-chip.passed{color:var(--teal);background:#123735}.outcome-chip.wrong_output{color:var(--coral);background:#3b201e}.outcome-chip.runtime_error,.outcome-chip.timeout{color:var(--amber);background:#3d2e14}.feedback-panel{padding:16px}.empty-state{padding:16px;margin-top:16px;color:var(--muted);background:var(--surface-alt);border:1px dashed var(--border);border-radius:4px}.feedback-panel h3{margin-top:20px}.callout,.profile-card,.hint{padding:12px;color:var(--muted);background:var(--surface-alt);border:1px solid var(--border);border-radius:4px}.feedback-tags{display:flex;flex-wrap:wrap;gap:6px}.tag{padding:3px 8px;color:var(--coral);border:1px solid var(--coral);background:transparent}.hints{display:grid;gap:8px}.hint{color:var(--text)}.hint.locked{color:var(--muted);border-style:dashed}.hint-note{color:var(--muted);font-size:12px}.profile-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}.profile-grid>section{min-width:0}.profile-card{min-height:74px}.profile-card dl{display:flex;justify-content:space-between;margin:0 0 8px}.profile-card dd{margin:0;color:var(--teal)}.progress{height:7px;margin-top:4px;background:#26313c;border-radius:4px;overflow:hidden}.progress span{display:block;height:100%;background:var(--teal)}.progress.amber span{background:var(--amber)}.progress.coral span{background:var(--coral)}.recommendation{color:var(--text)}.trace-toolbar{justify-content:flex-start;margin:16px 0}.step-counter{margin-left:auto;color:var(--teal);font-family:"IBM Plex Mono",monospace;font-size:12px}.trace-empty{padding:16px;color:var(--muted);background:var(--surface-alt);border:1px dashed var(--border);border-radius:4px}.trace-view{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:16px}.trace-code{padding:14px;background:var(--surface-alt);border:1px solid var(--border);border-radius:4px}.trace-code pre{margin:0;white-space:pre-wrap;color:var(--text)}.trace-current{color:var(--amber);font-family:"IBM Plex Mono",monospace}.trace-vars{display:grid;gap:8px}.trace-var{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:8px;background:var(--surface-alt);border:1px solid var(--border);border-radius:4px}.trace-var code{overflow-wrap:anywhere}.trace-var small{grid-column:2;color:var(--muted)}.trace-changes{display:flex;flex-wrap:wrap;gap:6px}.trace-side h3{margin-top:0;margin-top:16px}.trace-side h3:first-child{margin-top:0}.hidden{display:none}@media(max-width:1099px){.app-shell{grid-template-columns:260px minmax(0,1fr)}.feedback-column{grid-column:1/-1}.feedback-panel{position:static}.profile-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.topbar{align-items:flex-start;flex-direction:column}.app-shell{display:block;padding:12px}.navigator,.feedback-column,.middle-column{margin-bottom:12px}.navigator,.feedback-panel{position:static}.profile-grid,.trace-view{grid-template-columns:1fr}.actions{align-items:stretch;flex-direction:column}.actions>*{width:100%;margin-left:0}.step-counter{margin-left:0}.learner{grid-template-columns:auto 1fr;width:100%}.learner input,.learner small{grid-column:2;width:100%}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important}}

.ai-status-badge{padding:4px 8px;color:var(--muted);border:1px solid var(--border);border-radius:4px;font-size:12px}.ai-tutor-controls{display:grid;gap:8px;margin-top:16px}.ai-tutor-controls button{width:100%}



.ai-status-badge{padding:4px 8px;border:1px solid var(--border);border-radius:4px;font-size:12px}.ai-status-badge.on{color:var(--teal);border-color:var(--teal)}.ai-status-badge.off{color:var(--muted)}
